# Copy this file to .env.local and adjust for your machine.
# .env.local is gitignored by default (see .gitignore).

# Public site origin — used for metadata, canonical URLs, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Laravel API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
